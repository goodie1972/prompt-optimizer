# ============================================================
# prompt-optimizer MCP 服务器 — 环境变量配置模板
# 复制到项目根目录重命名为 .env，取消注释你要用的服务商
# ============================================================

# ---------- 🔷 NVIDIA NIM（免费额度，推荐） ----------
# 注册：https://build.nvidia.com/explore/discover
#OPTIMIZE_API_KEY=${NVIDIA_API_KEY}
#OPTIMIZE_BASE_URL=https://integrate.api.nvidia.com/v1
#OPTIMIZE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ---------- 🌐 Agnes AI ----------
# 注册：https://apihub.agnes-ai.com
#AGNES_API_KEY=sk-你的key
#OPTIMIZE_API_KEY=${AGNES_API_KEY}
#OPTIMIZE_BASE_URL=https://apihub.agnes-ai.com/v1
#OPTIMIZE_MODEL=agnes-2.0-flash

# ---------- 🔗 OpenRouter（聚合多家模型，有免费额度） ----------
# 注册：https://openrouter.ai/keys
#OPENROUTER_API_KEY=sk-or-v1-你的key
#OPTIMIZE_API_KEY=${OPENROUTER_API_KEY}
#OPTIMIZE_BASE_URL=https://openrouter.ai/api/v1
#OPTIMIZE_MODEL=deepseek/deepseek-chat

# ---------- 🏠 Ollama（本地，完全免费，需安装） ----------
# Ollama Cloud
#OPTIMIZE_API_KEY=
#OPTIMIZE_BASE_URL=https://ollama.com/v1
#OPTIMIZE_MODEL=gemma4:31b